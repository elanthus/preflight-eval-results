{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-preflight-evals.local/schemas/private/curator-import.schema.json",
  "title": "Private curator import manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "expected_record_count",
    "tokenizer",
    "context_size_bands",
    "records"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "pattern": "^curator-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "expected_record_count": {"const": 24},
    "tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "name", "version", "method"],
      "properties": {
        "implementation": {"const": "tiktoken"},
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "method": {"const": "per_file_utf8_sum_v1"}
      }
    },
    "context_size_bands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["small_max_tokens", "medium_max_tokens"],
      "properties": {
        "small_max_tokens": {"type": "integer", "minimum": 1},
        "medium_max_tokens": {"type": "integer", "minimum": 2}
      }
    },
    "records": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "fullSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\u0000]+$"
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_bytes", "estimated_tokens"],
      "properties": {
        "selected_bytes": {"type": ["integer", "null"], "minimum": 0},
        "estimated_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_id",
        "case_id",
        "defect_category",
        "source",
        "commits",
        "affected_paths",
        "repository_requirements",
        "disposition",
        "reason_code",
        "reason_detail",
        "token_estimates",
        "verification"
      ],
      "properties": {
        "source_record_id": {"type": "string", "pattern": "^source-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
        "defect_category": {
          "enum": ["correctness", "security", "evaluation_integrity", "operational_contract"]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "pull_request"],
          "properties": {
            "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "pull_request": {"type": "integer", "minimum": 1}
          }
        },
        "commits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base", "vulnerable", "repair", "fixed"],
          "properties": {
            "base": {"$ref": "#/$defs/fullSha"},
            "vulnerable": {"$ref": "#/$defs/fullSha"},
            "repair": {"oneOf": [{"$ref": "#/$defs/fullSha"}, {"type": "null"}]},
            "fixed": {"oneOf": [{"$ref": "#/$defs/fullSha"}, {"type": "null"}]}
          }
        },
        "affected_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryPath"}
        },
        "repository_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["submodules", "lfs"],
          "properties": {
            "submodules": {"enum": ["none", "required"]},
            "lfs": {"enum": ["none", "required"]}
          }
        },
        "disposition": {"enum": ["replayable", "special_manual", "rejected"]},
        "reason_code": {
          "enum": [
            null,
            "external_setting",
            "unrepaired_followup",
            "ambiguous_reconstruction",
            "insufficient_context",
            "verification_failed",
            "other"
          ]
        },
        "reason_detail": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
        "token_estimates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vulnerable", "fixed"],
          "properties": {
            "vulnerable": {"$ref": "#/$defs/measurement"},
            "fixed": {"$ref": "#/$defs/measurement"}
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "curator", "verifier", "verified_at", "method", "checks"],
          "properties": {
            "status": {"enum": ["verified", "special_manual", "rejected"]},
            "curator": {"type": "string", "minLength": 1, "maxLength": 120},
            "verifier": {"type": "string", "minLength": 1, "maxLength": 120},
            "verified_at": {"type": "string", "format": "date-time"},
            "method": {"type": "string", "minLength": 1, "maxLength": 500},
            "checks": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "commits_exist",
                "commits_reachable",
                "repair_relationship_verified",
                "clean_materialization",
                "mechanism_present_vulnerable",
                "mechanism_absent_fixed",
                "context_reviewable",
                "no_duplicate_mechanism",
                "gold_material_generated",
                "second_curator_approved"
              ],
              "properties": {
                "commits_exist": {"type": "boolean"},
                "commits_reachable": {"type": "boolean"},
                "repair_relationship_verified": {"type": "boolean"},
                "clean_materialization": {"type": "boolean"},
                "mechanism_present_vulnerable": {"type": "boolean"},
                "mechanism_absent_fixed": {"type": "boolean"},
                "context_reviewable": {"type": "boolean"},
                "no_duplicate_mechanism": {"type": "boolean"},
                "gold_material_generated": {"type": "boolean"},
                "second_curator_approved": {"type": "boolean"}
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "replayable"}}, "required": ["disposition"]},
          "then": {
            "properties": {
              "reason_code": {"type": "null"},
              "reason_detail": {"type": "null"},
              "commits": {
                "properties": {
                  "repair": {"$ref": "#/$defs/fullSha"},
                  "fixed": {"$ref": "#/$defs/fullSha"}
                }
              },
              "token_estimates": {
                "properties": {
                  "vulnerable": {
                    "properties": {
                      "selected_bytes": {"type": "integer"},
                      "estimated_tokens": {"type": "integer"}
                    }
                  },
                  "fixed": {
                    "properties": {
                      "selected_bytes": {"type": "integer"},
                      "estimated_tokens": {"type": "integer"}
                    }
                  }
                }
              },
              "verification": {
                "properties": {
                  "status": {"const": "verified"},
                  "checks": {
                    "properties": {
                      "commits_exist": {"const": true},
                      "commits_reachable": {"const": true},
                      "repair_relationship_verified": {"const": true},
                      "clean_materialization": {"const": true},
                      "mechanism_present_vulnerable": {"const": true},
                      "mechanism_absent_fixed": {"const": true},
                      "context_reviewable": {"const": true},
                      "no_duplicate_mechanism": {"const": true},
                      "gold_material_generated": {"const": true},
                      "second_curator_approved": {"const": true}
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "reason_code": {"type": "string"},
              "reason_detail": {"type": "string"}
            }
          }
        }
      ]
    }
  }
}
