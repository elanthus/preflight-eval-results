{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-preflight-evals.local/schemas/catalog.schema.json",
  "title": "Curator/scorer-only corpus provenance catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "source_evidence",
    "generated_at",
    "visibility",
    "records",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "corpus_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120},
    "source_evidence": {"type": "string", "format": "uri", "maxLength": 500},
    "generated_at": {"type": "string", "format": "date-time"},
    "visibility": {"const": "curator_and_scorer_only"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    },
    "notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    }
  },
  "$defs": {
    "fullSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "finding_id",
        "finding_id_source",
        "repository",
        "pull_request",
        "commits",
        "disposition"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
        "finding_id": {"type": "string", "pattern": "^F[0-9]{3}$"},
        "finding_id_source": {"enum": ["source_review", "local_ordinal"]},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "pull_request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "title", "url"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "title": {"type": "string", "minLength": 1, "maxLength": 300},
            "url": {"type": "string", "format": "uri", "maxLength": 500}
          }
        },
        "commits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base", "vulnerable", "repairs", "fixed"],
          "properties": {
            "base": {"$ref": "#/$defs/fullSha"},
            "vulnerable": {"$ref": "#/$defs/fullSha"},
            "repairs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/fullSha"}
            },
            "fixed": {
              "oneOf": [
                {"$ref": "#/$defs/fullSha"},
                {"type": "null"}
              ]
            }
          }
        },
        "disposition": {
          "enum": [
            "paired_draft",
            "special-unrepaired-followup",
            "special-external-setting"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"disposition": {"const": "paired_draft"}},
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "commits": {
                "properties": {
                  "repairs": {"minItems": 1},
                  "fixed": {"$ref": "#/$defs/fullSha"}
                }
              }
            }
          },
          "else": {
            "properties": {
              "commits": {
                "properties": {
                  "repairs": {"maxItems": 0},
                  "fixed": {"type": "null"}
                }
              }
            }
          }
        }
      ]
    }
  }
}
