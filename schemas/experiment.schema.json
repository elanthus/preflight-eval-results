{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-preflight-evals.local/schemas/experiment.schema.json",
  "title": "Frozen experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "cases",
    "case_manifest_checksum",
    "baseline_profile",
    "candidate_profile",
    "snapshot_set",
    "repetitions",
    "execution_order",
    "randomization_seed",
    "reviewer_config",
    "retry_policy",
    "invalid_output_policy",
    "code_revision",
    "environment_lock_digest",
    "planned_run_count",
    "created_at",
    "approved_by",
    "approved_at",
    "frozen"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4", "1.5"]},
    "experiment_id": {"type": "string", "pattern": "^experiment-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "role"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
          "role": {"enum": ["development", "holdout"]},
          "case_contract_digest": {"$ref": "#/$defs/digest"},
          "vulnerable_snapshot": {"$ref": "#/$defs/fullSha"},
          "fixed_snapshot": {"$ref": "#/$defs/fullSha"}
        }
      }
    },
    "case_manifest_checksum": {"$ref": "#/$defs/digest"},
    "baseline_profile": {"$ref": "#/$defs/versionedDigest"},
    "candidate_profile": {"$ref": "#/$defs/versionedDigest"},
    "required_bundle_schema_version": {"const": "2"},
    "prompt_template": {"$ref": "#/$defs/versionedDigest"},
    "analysis_plan": {"$ref": "#/$defs/versionedDigest"},
    "holdout_access_enabled": {"type": "boolean"},
    "price_projection": {"$ref": "#/$defs/priceProjection"},
    "recovery_source": {"$ref": "#/$defs/recoverySource"},
    "holdout_source": {"$ref": "#/$defs/holdoutSource"},
    "snapshot_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["vulnerable", "fixed"]}
    },
    "repetitions": {"type": "integer", "minimum": 1},
    "execution_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "case_id", "snapshot", "condition", "repetition"],
        "properties": {
          "run_id": {"type": "string", "pattern": "^run-[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
          "snapshot": {"enum": ["vulnerable", "fixed"]},
          "condition": {"enum": ["baseline", "candidate"]},
          "repetition": {"type": "integer", "minimum": 1},
          "request_seed": {"type": "integer", "minimum": 0},
          "estimated_input_tokens": {"type": "integer", "minimum": 0}
        }
      }
    },
    "randomization_seed": {"type": "integer", "minimum": 0},
    "reviewer_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "tool_policy",
        "input_token_limit",
        "output_token_limit",
        "output_schema_version",
        "adapter_version",
        "timeout_seconds",
        "temperature"
      ],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 200},
        "tool_policy": {"type": "string", "minLength": 1, "maxLength": 200},
        "input_token_limit": {"type": "integer", "minimum": 1},
        "output_token_limit": {"type": "integer", "minimum": 1},
        "output_schema_version": {"const": "1.0"},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2}
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_attempts", "retryable_failures"],
      "properties": {
        "maximum_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "retryable_failures": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["invalid_output", "provider_error", "adapter_error", "timeout"]}
        }
      }
    },
    "invalid_output_policy": {"enum": ["fail_run", "retry_then_fail"]},
    "code_revision": {"$ref": "#/$defs/fullSha"},
    "environment_lock_digest": {"$ref": "#/$defs/digest"},
    "adapter_capabilities": {"$ref": "#/$defs/adapterCapabilities"},
    "content_digest": {"$ref": "#/$defs/digest"},
    "planned_run_count": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "approved_by": {"type": ["string", "null"], "maxLength": 120},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "frozen": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.0"}}, "required": ["schema_version"]},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["adapter_capabilities"]},
            {"required": ["content_digest"]},
            {"required": ["prompt_template"]},
            {"required": ["analysis_plan"]},
            {"required": ["holdout_access_enabled"]},
            {"required": ["price_projection"]},
            {"required": ["recovery_source"]},
            {"required": ["holdout_source"]}
          ]
        },
        "properties": {
          "cases": {
            "items": {
              "not": {
                "anyOf": [
                  {"required": ["case_contract_digest"]},
                  {"required": ["vulnerable_snapshot"]},
                  {"required": ["fixed_snapshot"]}
                ]
              }
            }
          },
          "execution_order": {
            "items": {
              "not": {
                "anyOf": [{"required": ["request_seed"]}, {"required": ["estimated_input_tokens"]}]
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.1"}}, "required": ["schema_version"]},
      "then": {
        "required": ["adapter_capabilities", "content_digest"],
        "not": {
          "anyOf": [
            {"required": ["prompt_template"]},
            {"required": ["analysis_plan"]},
            {"required": ["holdout_access_enabled"]},
            {"required": ["price_projection"]},
            {"required": ["recovery_source"]},
            {"required": ["holdout_source"]}
          ]
        },
        "properties": {
          "cases": {
            "items": {
              "required": ["case_contract_digest", "vulnerable_snapshot", "fixed_snapshot"]
            }
          },
          "execution_order": {
            "items": {"required": ["request_seed", "estimated_input_tokens"]}
          },
          "frozen": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.2"}}, "required": ["schema_version"]},
      "then": {
        "required": [
          "adapter_capabilities",
          "content_digest",
          "prompt_template",
          "analysis_plan",
          "holdout_access_enabled",
          "price_projection"
        ],
        "properties": {
          "cases": {
            "items": {
              "required": ["case_contract_digest", "vulnerable_snapshot", "fixed_snapshot"]
            }
          },
          "execution_order": {
            "items": {"required": ["request_seed", "estimated_input_tokens"]}
          },
          "frozen": {"const": true}
        },
        "not": {
          "anyOf": [
            {"required": ["recovery_source"]},
            {"required": ["holdout_source"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.4"}}, "required": ["schema_version"]},
      "then": {
        "required": [
          "adapter_capabilities",
          "content_digest",
          "prompt_template",
          "analysis_plan",
          "holdout_access_enabled",
          "price_projection",
          "holdout_source"
        ],
        "properties": {
          "holdout_access_enabled": {"const": true},
          "cases": {
            "items": {
              "required": ["case_contract_digest", "vulnerable_snapshot", "fixed_snapshot"]
            }
          },
          "execution_order": {
            "items": {"required": ["request_seed", "estimated_input_tokens"]}
          },
          "frozen": {"const": true}
        },
        "not": {"required": ["recovery_source"]}
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.3"}}, "required": ["schema_version"]},
      "then": {
        "required": [
          "adapter_capabilities",
          "content_digest",
          "prompt_template",
          "analysis_plan",
          "holdout_access_enabled",
          "price_projection",
          "recovery_source"
        ],
        "properties": {
          "cases": {
            "items": {
              "required": ["case_contract_digest", "vulnerable_snapshot", "fixed_snapshot"]
            }
          },
          "execution_order": {
            "items": {"required": ["request_seed", "estimated_input_tokens"]}
          },
          "frozen": {"const": true}
        },
        "not": {"required": ["holdout_source"]}
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.5"}}, "required": ["schema_version"]},
      "then": {
        "required": [
          "adapter_capabilities",
          "content_digest",
          "prompt_template",
          "analysis_plan",
          "holdout_access_enabled",
          "price_projection",
          "recovery_source",
          "holdout_source"
        ],
        "properties": {
          "holdout_access_enabled": {"const": true},
          "recovery_source": {
            "allOf": [
              {"$ref": "#/$defs/recoverySource"},
              {
                "required": ["provider_error_failures"],
                "properties": {
                  "selection_policy": {"const": "terminal-provider-failures-v1"}
                }
              }
            ]
          },
          "cases": {
            "items": {
              "required": ["case_contract_digest", "vulnerable_snapshot", "fixed_snapshot"]
            }
          },
          "execution_order": {
            "items": {"required": ["request_seed", "estimated_input_tokens"]}
          },
          "frozen": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"frozen": {"const": true}}, "required": ["frozen"]},
      "then": {
        "properties": {
          "approved_by": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  ],
  "$defs": {
    "fullSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "versionedDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "adapterCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_version",
        "executable_version",
        "executable_digest",
        "review_arguments",
        "version_arguments",
        "probe_timeout_seconds",
        "maximum_stdout_bytes",
        "maximum_stderr_bytes",
        "working_directory_policy",
        "environment_policy",
        "termination_policy",
        "capabilities",
        "content_digest"
      ],
      "properties": {
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "executable_version": {"type": "string", "minLength": 1, "maxLength": 200},
        "executable_digest": {"$ref": "#/$defs/digest"},
        "review_arguments": {"$ref": "#/$defs/arguments"},
        "version_arguments": {"$ref": "#/$defs/arguments"},
        "probe_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "maximum_stdout_bytes": {"type": "integer", "minimum": 1, "maximum": 16000000},
        "maximum_stderr_bytes": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "working_directory_policy": {"const": "explicit-empty-directory-v1"},
        "environment_policy": {"const": "minimal-allowlist-v1"},
        "termination_policy": {"const": "new-session-term-kill-v1"},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        },
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "arguments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 10000, "pattern": "^[^\\u0000-\\u001f]+$"}
    },
    "priceProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price_table_version",
        "currency",
        "input_usd_per_million_tokens",
        "output_usd_per_million_tokens",
        "maximum_input_tokens",
        "maximum_output_tokens",
        "contingency_rate",
        "projected_cost_usd"
      ],
      "properties": {
        "price_table_version": {"type": "string", "minLength": 1, "maxLength": 120},
        "currency": {"const": "USD"},
        "input_usd_per_million_tokens": {"type": "number", "minimum": 0},
        "output_usd_per_million_tokens": {"type": "number", "minimum": 0},
        "maximum_input_tokens": {"type": "integer", "minimum": 1},
        "maximum_output_tokens": {"type": "integer", "minimum": 1},
        "contingency_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "projected_cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "recoverySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "experiment_digest",
        "terminal_records_digest",
        "selection_policy",
        "output_limit_failures",
        "invalid_output_failures"
      ],
      "properties": {
        "experiment_id": {"type": "string", "pattern": "^experiment-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "experiment_digest": {"$ref": "#/$defs/digest"},
        "terminal_records_digest": {"$ref": "#/$defs/digest"},
        "selection_policy": {
          "enum": [
            "terminal-output-failures-v1",
            "terminal-output-failures-v2",
            "terminal-provider-failures-v1"
          ]
        },
        "output_limit_failures": {"type": "integer", "minimum": 0},
        "invalid_output_failures": {"type": "integer", "minimum": 0},
        "provider_error_failures": {"type": "integer", "minimum": 0},
        "implementation_transition": {"$ref": "#/$defs/implementationTransition"}
      }
    },
    "implementationTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_code_revision",
        "source_environment_lock_digest",
        "target_code_revision",
        "target_environment_lock_digest",
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "source_code_revision": {"$ref": "#/$defs/fullSha"},
        "source_environment_lock_digest": {"$ref": "#/$defs/digest"},
        "target_code_revision": {"$ref": "#/$defs/fullSha"},
        "target_environment_lock_digest": {"$ref": "#/$defs/digest"},
        "approved_by": {"type": "string", "minLength": 1, "maxLength": 120},
        "approved_at": {"type": "string", "format": "date-time"}
      }
    },
    "holdoutSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "experiment_digest",
        "development_records_digest",
        "selection_policy",
        "development_records",
        "holdout_records"
      ],
      "properties": {
        "experiment_id": {"type": "string", "pattern": "^experiment-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "experiment_digest": {"$ref": "#/$defs/digest"},
        "development_records_digest": {"$ref": "#/$defs/digest"},
        "selection_policy": {"const": "frozen-holdout-v1"},
        "development_records": {"type": "integer", "minimum": 1},
        "holdout_records": {"type": "integer", "minimum": 1}
      }
    }
  }
}
