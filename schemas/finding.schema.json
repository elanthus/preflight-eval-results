{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-preflight-evals.local/schemas/finding.schema.json",
  "title": "Structured reviewer finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "title",
    "explanation",
    "file_path",
    "severity",
    "defect_category",
    "failure_mechanism",
    "confidence",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "finding_id": {"type": "string", "pattern": "^F[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "explanation": {"type": "string", "minLength": 1, "maxLength": 4000},
    "file_path": {"$ref": "#/$defs/repositoryPath"},
    "start_line": {"type": ["integer", "null"], "minimum": 1},
    "end_line": {"type": ["integer", "null"], "minimum": 1},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "defect_category": {
      "enum": ["correctness", "security", "evaluation_integrity", "operational_contract"]
    },
    "failure_mechanism": {"type": "string", "minLength": 1, "maxLength": 2000},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "reference"],
        "properties": {
          "source_type": {"enum": ["file", "diff", "tool"]},
          "reference": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\u0000]+$"
    }
  }
}
