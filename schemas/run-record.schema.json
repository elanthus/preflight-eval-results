{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-preflight-evals.local/schemas/run-record.schema.json",
  "title": "Atomic reviewer run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "prompt_manifest_digest",
    "output_schema_version",
    "attempt",
    "status",
    "started_at",
    "ended_at",
    "monotonic_latency_ms",
    "provider_request_id",
    "seed",
    "reviewer_output",
    "validation_errors",
    "usage",
    "price_table_version",
    "cost",
    "subprocess",
    "retry_history",
    "raw_artifacts"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "experiment_id": {"type": "string", "pattern": "^experiment-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "prompt_manifest_digest": {"$ref": "#/$defs/digest"},
    "output_schema_version": {"const": "1.0"},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["succeeded", "invalid_output", "provider_error", "configuration_error", "adapter_error", "timeout"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "monotonic_latency_ms": {"type": "number", "minimum": 0},
    "provider_request_id": {"type": ["string", "null"], "maxLength": 200},
    "seed": {"type": ["integer", "null"]},
    "reviewer_output": {
      "oneOf": [
        {"$ref": "https://agentic-preflight-evals.local/schemas/reviewer-output.schema.json"},
        {"type": "null"}
      ]
    },
    "validation_errors": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "reasoning_tokens"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "price_table_version": {"type": ["string", "null"], "maxLength": 100},
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "input", "output", "total"],
      "properties": {
        "currency": {"const": "USD"},
        "input": {"type": ["number", "null"], "minimum": 0},
        "output": {"type": ["number", "null"], "minimum": 0},
        "total": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "subprocess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_status", "stderr_classification"],
      "properties": {
        "exit_status": {"type": ["integer", "null"]},
        "stderr_classification": {
          "enum": ["none", "usage", "configuration", "provider", "timeout", "internal", "redacted_unknown"]
        }
      }
    },
    "retry_history": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt", "classification"],
        "properties": {
          "attempt": {"type": "integer", "minimum": 1},
          "classification": {
            "enum": ["invalid_output", "provider_error", "adapter_error", "timeout"]
          }
        }
      }
    },
    "raw_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_path", "request_digest", "response_path", "response_digest"],
      "properties": {
        "request_path": {"oneOf": [{"$ref": "#/$defs/repositoryPath"}, {"type": "null"}]},
        "request_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "response_path": {"oneOf": [{"$ref": "#/$defs/repositoryPath"}, {"type": "null"}]},
        "response_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    },
    "identity": {"$ref": "#/$defs/executionIdentity"},
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.0"}}, "required": ["schema_version"]},
      "then": {
        "properties": {
          "status": {"enum": ["succeeded", "invalid_output", "provider_error", "adapter_error", "timeout"]}
        },
        "not": {"anyOf": [{"required": ["identity"]}, {"required": ["content_digest"]}]}
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.1"}}, "required": ["schema_version"]},
      "then": {"required": ["identity", "content_digest"]}
    },
    {
      "if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]},
      "then": {
        "properties": {
          "reviewer_output": {"not": {"type": "null"}},
          "validation_errors": {"maxItems": 0},
          "subprocess": {
            "properties": {
              "exit_status": {"const": 0},
              "stderr_classification": {"const": "none"}
            }
          }
        }
      },
      "else": {"properties": {"reviewer_output": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "invalid_output"}}, "required": ["status"]},
      "then": {"properties": {"reviewer_output": {"type": "null"}, "validation_errors": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\u0000]+$"
    },
    "executionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_content_digest",
        "source_commit",
        "worktree_digest",
        "bundle_digest",
        "context_entry_digest",
        "request_id",
        "request_digest",
        "profile_digest",
        "reviewer_config_digest",
        "adapter_capabilities_digest",
        "reviewer_output_digest"
      ],
      "properties": {
        "experiment_content_digest": {"$ref": "#/$defs/digest"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "worktree_digest": {"$ref": "#/$defs/digest"},
        "bundle_digest": {"$ref": "#/$defs/digest"},
        "context_entry_digest": {"$ref": "#/$defs/digest"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "request_digest": {"$ref": "#/$defs/digest"},
        "profile_digest": {"$ref": "#/$defs/digest"},
        "reviewer_config_digest": {"$ref": "#/$defs/digest"},
        "adapter_capabilities_digest": {"$ref": "#/$defs/digest"},
        "reviewer_output_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    }
  }
}
