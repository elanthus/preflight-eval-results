{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-preflight-evals.local/schemas/corpus-split.schema.json",
  "title": "Frozen private development and holdout split",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "seed",
    "target_holdout_count",
    "locked_development",
    "assignments",
    "ordered_holdout",
    "ordered_holdout_checksum",
    "balance",
    "objective_score",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "algorithm": {"const": "exhaustive-stratified-squared-deviation-v1"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "target_holdout_count": {"type": "integer", "minimum": 1},
    "locked_development": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/case_id"}
    },
    "assignments": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/assignment"}
    },
    "ordered_holdout": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/case_id"}
    },
    "ordered_holdout_checksum": {"$ref": "#/$defs/digest"},
    "balance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/balance_cell"}
    },
    "objective_score": {"type": "integer", "minimum": 0},
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 160
    },
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "role",
        "repository",
        "defect_category",
        "context_size_band"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/case_id"},
        "role": {"enum": ["development", "holdout"]},
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 200
        },
        "defect_category": {
          "enum": ["correctness", "security", "evaluation_integrity", "operational_contract"]
        },
        "context_size_band": {"enum": ["small", "medium", "large"]}
      }
    },
    "balance_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "value", "total", "development", "holdout"],
      "properties": {
        "dimension": {"enum": ["repository", "defect_category", "context_size_band"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 200},
        "total": {"type": "integer", "minimum": 0},
        "development": {"type": "integer", "minimum": 0},
        "holdout": {"type": "integer", "minimum": 0}
      }
    }
  }
}
