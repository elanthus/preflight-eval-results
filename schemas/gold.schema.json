{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-preflight-evals.local/schemas/gold.schema.json",
  "title": "Scorer-only expected behavior",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "expected_behavior",
    "expected_mechanisms",
    "forbidden_expected_phrases",
    "fixed_only_fingerprints",
    "curator_notes",
    "adjudication"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1", "2.0"]},
    "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
    "expected_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vulnerable", "fixed"],
      "properties": {
        "vulnerable": {"type": "string", "minLength": 1, "maxLength": 2000},
        "fixed": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "expected_mechanisms": {
      "type": "array",
      "minItems": 1
    },
    "acceptable_locations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/acceptableLocation"}
    },
    "accepted_defect_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/defectCategory"}
    },
    "severity_range": {
      "$ref": "#/$defs/severityRange"
    },
    "forbidden_expected_phrases": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "fixed_only_fingerprints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["digest", "source_path", "source_record_id"],
        "properties": {
          "digest": {"$ref": "#/$defs/digest"},
          "source_path": {"$ref": "#/$defs/repositoryPath"},
          "source_record_id": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "curator_notes": {"type": "string", "maxLength": 4000},
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "accepted_alternative_matches"],
      "properties": {
        "required": {"type": "boolean"},
        "accepted_alternative_matches": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"enum": ["1.0", "1.1"]}},
        "required": ["schema_version"]
      },
      "then": {
        "required": [
          "acceptable_locations",
          "accepted_defect_categories",
          "severity_range",
          "provenance"
        ],
        "properties": {
          "expected_mechanisms": {"items": {"$ref": "#/$defs/expectedMechanismV1"}}
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "1.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "acceptable_locations": {
            "items": {"not": {"required": ["aliases"]}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "2.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "expected_mechanisms": {"items": {"$ref": "#/$defs/expectedMechanismV2"}}
        },
        "not": {
          "anyOf": [
            {"required": ["acceptable_locations"]},
            {"required": ["accepted_defect_categories"]},
            {"required": ["severity_range"]},
            {"required": ["provenance"]}
          ]
        }
      }
    }
  ],
  "$defs": {
    "expectedMechanismV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism_id", "description", "adjudication_rubric"],
      "properties": {
        "mechanism_id": {"$ref": "#/$defs/mechanismId"},
        "description": {"type": "string", "minLength": 1, "maxLength": 2000},
        "adjudication_rubric": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "expectedMechanismV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism_id",
        "description",
        "adjudication_rubric",
        "evaluation_role",
        "snapshot_expectations",
        "acceptable_locations",
        "accepted_defect_categories",
        "severity_range",
        "provenance"
      ],
      "properties": {
        "mechanism_id": {"$ref": "#/$defs/mechanismId"},
        "description": {"type": "string", "minLength": 1, "maxLength": 2000},
        "adjudication_rubric": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evaluation_role": {"enum": ["primary", "supplemental"]},
        "snapshot_expectations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vulnerable", "fixed"],
          "properties": {
            "vulnerable": {"$ref": "#/$defs/snapshotExpectation"},
            "fixed": {"$ref": "#/$defs/snapshotExpectation"}
          }
        },
        "acceptable_locations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/acceptableLocation"}
        },
        "accepted_defect_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/defectCategory"}
        },
        "severity_range": {"$ref": "#/$defs/severityRange"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "acceptableLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryPath"}
        },
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "severityRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"$ref": "#/$defs/severity"},
        "maximum": {"$ref": "#/$defs/severity"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excerpt", "source_record_id"],
      "properties": {
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 4000},
        "source_record_id": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "mechanismId": {
      "type": "string",
      "pattern": "^mechanism-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "snapshotExpectation": {"enum": ["present", "absent", "unverified"]},
    "defectCategory": {
      "enum": ["correctness", "security", "evaluation_integrity", "operational_contract"]
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\u0000]+$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "severity": {"enum": ["low", "medium", "high", "critical"]}
  }
}
