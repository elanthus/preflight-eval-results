{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-preflight-evals.local/schemas/prompt-manifest.schema.json",
  "title": "Reviewer prompt manifest",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "schema_version": {"const": "1.0"},
        "leakage": {"$ref": "#/$defs/legacyLeakage"}
      },
      "not": {
        "anyOf": [
          {"required": ["bundle_digest"]},
          {"required": ["bundle_byte_count"]},
          {"required": ["bundle_token_count"]},
          {"required": ["context_entry_digest"]},
          {"required": ["context_byte_count"]},
          {"required": ["context_token_count"]},
          {"required": ["bundle_config"]},
          {"required": ["request_identity"]},
          {"required": ["bundle_schema_version"]}
        ]
      }
    },
    {
      "properties": {
        "schema_version": {"const": "1.1"},
        "leakage": {"$ref": "#/$defs/legacyLeakage"}
      },
      "required": [
        "bundle_digest",
        "bundle_byte_count",
        "bundle_token_count",
        "context_entry_digest",
        "context_byte_count",
        "context_token_count",
        "bundle_config"
      ],
      "not": {
        "anyOf": [
          {"required": ["request_identity"]},
          {"required": ["bundle_schema_version"]}
        ]
      }
    },
    {
      "properties": {
        "schema_version": {"const": "1.2"},
        "leakage": {"$ref": "#/$defs/passedLeakage"}
      },
      "required": [
        "bundle_digest",
        "bundle_byte_count",
        "bundle_token_count",
        "context_entry_digest",
        "context_byte_count",
        "context_token_count",
        "bundle_config"
      ],
      "not": {
        "anyOf": [
          {"required": ["request_identity"]},
          {"required": ["bundle_schema_version"]}
        ]
      }
    },
    {
      "properties": {
        "schema_version": {"const": "1.3"},
        "leakage": {"$ref": "#/$defs/passedLeakage"},
        "bundle_schema_version": {"const": "2"}
      },
      "required": [
        "request_identity",
        "bundle_schema_version",
        "bundle_digest",
        "bundle_byte_count",
        "bundle_token_count",
        "context_entry_digest",
        "context_byte_count",
        "context_token_count",
        "bundle_config"
      ]
    }
  ],
  "required": [
    "schema_version",
    "case_id",
    "snapshot",
    "condition",
    "repetition",
    "request_id",
    "run_id",
    "source_commit",
    "worktree_digest",
    "bundle_entries",
    "prompt_template",
    "profile_template",
    "reviewer_config",
    "request_digest",
    "leakage",
    "created_at",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1", "1.2", "1.3"]},
    "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
    "snapshot": {"enum": ["vulnerable", "fixed"]},
    "request_identity": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "bundle_schema_version": {"const": "2"},
    "condition": {"enum": ["baseline", "candidate"]},
    "repetition": {"type": "integer", "minimum": 1},
    "seed": {"type": ["integer", "null"]},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "source_commit": {"$ref": "#/$defs/fullSha"},
    "worktree_digest": {"$ref": "#/$defs/digest"},
    "bundle_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "byte_count", "token_count", "content_digest", "truncated", "selection_reason"],
        "properties": {
          "path": {"$ref": "#/$defs/repositoryPath"},
          "byte_count": {"type": "integer", "minimum": 0},
          "token_count": {"type": "integer", "minimum": 0},
          "content_digest": {"$ref": "#/$defs/digest"},
          "truncated": {"type": "boolean"},
          "selection_reason": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "bundle_digest": {"$ref": "#/$defs/digest"},
    "bundle_byte_count": {"type": "integer", "minimum": 0},
    "bundle_token_count": {"type": "integer", "minimum": 0},
    "context_entry_digest": {"$ref": "#/$defs/digest"},
    "context_byte_count": {"type": "integer", "minimum": 0},
    "context_token_count": {"type": "integer", "minimum": 0},
    "bundle_config": {"$ref": "#/$defs/bundleConfig"},
    "prompt_template": {"$ref": "#/$defs/versionedDigest"},
    "profile_template": {"$ref": "#/$defs/versionedDigest"},
    "reviewer_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "tool_policy", "input_token_limit", "output_token_limit", "temperature", "adapter_version"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 200},
        "tool_policy": {"type": "string", "minLength": 1, "maxLength": 200},
        "input_token_limit": {"type": "integer", "minimum": 1},
        "output_token_limit": {"type": "integer", "minimum": 1},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "request_digest": {"$ref": "#/$defs/digest"},
    "leakage": {"oneOf": [
      {"$ref": "#/$defs/legacyLeakage"},
      {"$ref": "#/$defs/passedLeakage"}
    ]},
    "created_at": {"type": "string", "format": "date-time"},
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "legacyLeakage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "passed", "rule_ids"],
      "properties": {
        "policy_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "passed": {"type": "boolean"},
        "rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"}
        }
      }
    },
    "passedLeakage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "passed",
        "rule_ids",
        "index_digest",
        "approved_matches"
      ],
      "properties": {
        "policy_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "passed": {"const": true},
        "rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"}
        },
        "index_digest": {"$ref": "#/$defs/digest"},
        "approved_matches": {
          "type": "array",
          "items": {"$ref": "#/$defs/leakageMatch"}
        }
      }
    },
    "leakageMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "location_class", "match_digest", "exception_id"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
        "location_class": {
          "enum": [
            "serialized_request",
            "profile",
            "filename",
            "tool_configuration",
            "context_bundle"
          ]
        },
        "match_digest": {"$ref": "#/$defs/digest"},
        "exception_id": {
          "type": "string",
          "pattern": "^exception-[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "fullSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\u0000]+$"
    },
    "versionedDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "bundleConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "newline_policy", "tokenizer", "context_policy"],
      "properties": {
        "encoding": {"const": "utf-8"},
        "newline_policy": {"const": "normalize_lf_v1"},
        "tokenizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "name", "version", "method"],
          "properties": {
            "implementation": {"const": "tiktoken"},
            "name": {"type": "string", "minLength": 1, "maxLength": 120},
            "version": {"type": "string", "minLength": 1, "maxLength": 100},
            "method": {"const": "per_file_utf8_sum_v1"}
          }
        },
        "context_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "includes",
            "excludes",
            "per_file_byte_limit",
            "per_file_token_limit",
            "total_token_limit",
            "symlink_policy",
            "binary_policy",
            "truncation_policy"
          ],
          "properties": {
            "includes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/repositoryPath"}
            },
            "excludes": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/repositoryPath"}
            },
            "per_file_byte_limit": {"type": "integer", "minimum": 1},
            "per_file_token_limit": {"type": "integer", "minimum": 1},
            "total_token_limit": {"type": "integer", "minimum": 1},
            "symlink_policy": {"enum": ["reject", "follow_within_root"]},
            "binary_policy": {"enum": ["reject", "omit"]},
            "truncation_policy": {"enum": ["reject", "head", "head_tail"]}
          }
        }
      }
    }
  }
}
